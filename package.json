{
  "name": "munshi",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first AI business assistant for small businesses in India",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "backup": "node --disable-warning=ExperimentalWarning src/backup.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  }
}
