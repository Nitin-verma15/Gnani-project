# The assistant needs ONE of these two keys. Without either, it runs in demo mode.

# Google Gemini: has a free tier. Get a key at https://aistudio.google.com/apikey
# (On the free tier, Google may use your requests to improve its products.)
GEMINI_API_KEY=

# Anthropic Claude: paid, pay as you go. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gnani powers the voice (optional; without it the browser's own speech is used).
# Get a key at https://app.gnani.ai/voice/
GNANI_API_KEY=

# Optional:
# MUNSHI_PROVIDER=gemini         # which AI to use when both keys are set: gemini or claude
# GEMINI_MODEL=gemini-3.5-flash-lite  # the default; gemini-3.8-flash is newer but often busy
# GEMINI_THINKING=low            # minimal, low, medium or high
# MUNSHI_MODEL=claude-opus-5-5
# MUNSHI_EFFORT=medium
# PORT=3000

# Shops register and sign in by default. To run a single shop without accounts instead:
# MUNSHI_SINGLE_SHOP=1
# ...and optionally lock it behind a PIN (required then if MUNSHI_HOST is not this computer).
# MUNSHI_PIN=
# Listen on the shop's Wi-Fi so a phone or tablet can open it:
# MUNSHI_HOST=0.0.0.0

# Where accounts, every shop's books and their daily backups are kept:
# MUNSHI_DATA_DIR=data
# MUNSHI_BACKUP_DIR=data/backups
